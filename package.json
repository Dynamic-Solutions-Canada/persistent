{
  "name": "persistent",
  "version": "0.31.3",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspace @persistent/shared && npm run build --workspace @persistent/api && npm run build --workspace @persistent/web",
    "dev": "devkit run node scripts/dev/run-dev.mjs",
    "dev:cleanup": "devkit cleanup --yes",
    "dev:background": "npm run dev -- --background",
    "dev:down": "npm run dev -- --down",
    "dev:prepare-worktree": "devkit prepare && npm run --if-present dev:postprepare",
    "dev:postprepare": "npm run db:generate && npm run build --workspace @persistent/shared && lefthook install",
    "dev:container": "npm run db:wait && npm run db:generate && npm run db:migrate:deploy && npm run build --workspace @persistent/shared && concurrently -n shared,api,web -c magenta,green,blue \"npm run dev --workspace @persistent/shared\" \"npm run dev --workspace @persistent/api\" \"npm run dev --workspace @persistent/web\"",
    "dev:bootstrap": "devkit bootstrap",
    "dev:doctor": "devkit doctor",
    "dev:host": "devkit",
    "start:prod": "npm run prisma:migrate:deploy --workspace @persistent/api && node apps/api/dist/server.js",
    "deploy:prod": "node --env-file-if-exists=.env scripts/deploy/deploy-over-ssh.mjs",
    "db:generate": "npm run prisma:generate --workspace @persistent/api",
    "db:migrate": "npm run prisma:migrate:dev --workspace @persistent/api --",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @persistent/api",
    "db:seed": "tsx scripts/dev/seed-reminders.ts",
    "dev:session": "node --import tsx scripts/dev/demo-session.ts",
    "db:seed:demo": "tsx scripts/dev/seed-demo-listing.ts",
    "shots": "node --import tsx scripts/dev/store-assets.ts help",
    "shots:prepare": "node --import tsx scripts/dev/store-assets.ts prepare",
    "shots:render": "node --import tsx scripts/dev/render-store-assets.ts && python3 apps/desktop/external/winui-app-kit/scripts/store/render-screenshots.py",
    "check:screenshots": "python3 apps/desktop/external/winui-app-kit/scripts/store/render-screenshots.py --check",
    "hero": "devkit-store-hero",
    "check:hero": "devkit-store-hero --check",
    "check:kit-ref": "apps/desktop/external/winui-app-kit/scripts/check-kit-ref .",
    "shots:check": "node --import tsx scripts/dev/store-assets.ts check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:wait": "devkit-wait-for-db",
    "test": "env DATABASE_URL=postgresql://unit:unit@127.0.0.1:9/unit_test CLOUDFLARE_EMAIL_ACCOUNT_ID= CLOUDFLARE_EMAIL_API_TOKEN= FCM_SERVICE_ACCOUNT_FILE= FCM_PROJECT_ID= GOOGLE_WEB_CLIENT_ID= REVIEW_ACCOUNT_EMAIL= REVIEW_ACCOUNT_CODE= devkit-test",
    "test:integration": "devkit-test --integration",
    "test:desktop": "scripts/dev/test-desktop.sh",
    "test:android": "npm --prefix apps/mobile run test:android",
    "lint:android": "npm --prefix apps/mobile run lint:android",
    "check:android-notices": "npm --prefix apps/mobile run check:android-notices",
    "typecheck": "npm run typecheck --workspace @persistent/shared && npm run build --workspace @persistent/shared && npm run typecheck --workspace @persistent/api && npm run typecheck --workspace @persistent/web",
    "validate": "npm run build --workspace @persistent/shared && npm run format:check && npm run lint && npm run test && npm run typecheck && npm run prisma:validate --workspace @persistent/api && npm run check:devkit && npm run check:icons && npm run check:notices && npm run check:notes && npm run shots:check && npm run check:screenshots && npm run check:hero && npm run check:kit-ref",
    "check:devkit": "devkit-init --check",
    "check:icons": "devkit-icons --check",
    "check:notices": "devkit-notices --check --only apps/web/public/THIRD-PARTY-NOTICES.txt",
    "generate:notices:desktop": "python3 apps/desktop/external/winui-app-kit/scripts/generate-notices.py",
    "check:notices:desktop": "python3 apps/desktop/external/winui-app-kit/scripts/generate-notices.py --check",
    "notices": "devkit-notices",
    "icons": "devkit-icons",
    "check:listing": "devkit-test apps/mobile/scripts/play-images.test.ts apps/mobile/scripts/play-metadata.test.ts apps/mobile/scripts/play-publish.test.ts",
    "check:notes": "node scripts/release/notes.mjs check",
    "verify:desktop": "scripts/windows-build --build-only --configuration Debug",
    "install:desktop": "scripts/windows-build --install",
    "build:android": "scripts/dev/android-debug-build.sh",
    "android:connect": "scripts/dev/adb-connect.sh",
    "android:discover": "python3 scripts/dev/adb-discover.py",
    "android:emulator": "scripts/dev/android-emulator-attach.sh",
    "android:install": "adb install -r apps/mobile/android/app/build/outputs/apk/direct/debug/app-direct-debug.apk",
    "android:launch": "adb shell am start -W -n ca.persistent.app/.MainActivity",
    "android:logs": "scripts/dev/android-logcat.sh",
    "android:origin": "node scripts/dev/android-origin.mjs",
    "android:pair": "adb pair",
    "android:prepare": "npm --prefix apps/mobile run prepare:android",
    "android:test-device": "scripts/dev/android-device-test.sh",
    "verify:android": "npm --prefix apps/mobile run verify:android",
    "verify:desktop:csharp": "apps/desktop/verify-csharp.sh",
    "package:desktop:dev": "scripts/windows-build --dev",
    "package:desktop": "scripts/windows-build --no-sign",
    "dev:linux": "npm --prefix apps/linux-desktop run dev --",
    "build:linux": "npm run build --workspace @persistent/shared && npm --prefix apps/linux-desktop run build",
    "package:linux": "npm run build --workspace @persistent/shared && npm --prefix apps/linux-desktop run package --",
    "verify:linux": "npm --prefix apps/linux-desktop run typecheck",
    "install:linux": "npm run build:linux && node apps/linux-desktop/dist/install.cjs"
  },
  "devDependencies": {
    "@dynamic-solutions-canada/devkit": "github:Dynamic-Solutions-Canada/devkit#v0.30.0",
    "@eslint/js": "9.39.5",
    "@particle/dbus-next": "0.11.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "9.2.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "16.5.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "x11": "4.4.0"
  },
  "allowScripts": {
    "lefthook": false,
    "esbuild@0.28.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "github:Dynamic-Solutions-Canada/web-app-kit": true
  }
}
