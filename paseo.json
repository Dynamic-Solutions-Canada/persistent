{
  "worktree": {
    "setup": "bash scripts/dev/with-project-node.sh npm run dev:prepare-worktree",
    "teardown": "bash scripts/dev/with-project-node.sh npm run dev:down"
  },
  "scripts": {
    "dev-prepare-worktree": {
      "command": "bash scripts/dev/with-project-node.sh npm run dev:prepare-worktree"
    },
    "dev": {
      "command": "bash scripts/dev/with-project-node.sh npm run dev"
    },
    "dev-background": {
      "command": "bash scripts/dev/with-project-node.sh npm run dev:background"
    },
    "dev-down": {
      "command": "bash scripts/dev/with-project-node.sh npm run dev:down"
    },
    "dev-doctor": {
      "command": "bash scripts/dev/with-project-node.sh npm run dev:doctor"
    },
    "validate": {
      "command": "bash scripts/dev/with-project-node.sh npm run validate"
    },
    "test": {
      "command": "bash scripts/dev/with-project-node.sh npm test"
    },
    "build": {
      "command": "bash scripts/dev/with-project-node.sh npm run build"
    }
  }
}
