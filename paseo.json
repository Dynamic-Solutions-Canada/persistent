{
  "worktree": {
    "setup": "node \"$PASEO_SOURCE_CHECKOUT_PATH/node_modules/@ryanewen/devkit/bin/devkit.mjs\" run npm run dev:prepare-worktree",
    "teardown": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run dev:down"
  },
  "scripts": {
    "dev-prepare-worktree": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run dev:prepare-worktree"
    },
    "dev": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run dev"
    },
    "dev-background": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run dev:background"
    },
    "dev-down": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run dev:down"
    },
    "dev-doctor": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run dev:doctor"
    },
    "validate": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run validate"
    },
    "test": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm test"
    },
    "build": {
      "command": "node node_modules/@ryanewen/devkit/bin/devkit.mjs run npm run build"
    }
  }
}
