# Development settings (CONF-10). Copy to .env in your checkout; .env is git-ignored.
# Devkit derives DATABASE_URL, API_PORT, CLIENT_ORIGIN and Vite's ports for each
# checkout, and development Compose forces DEMO_MODE on, so everything here is
# optional. Server settings are in .env.server.example.

# --- Database ---
# Devkit supplies this; set it only to use a database outside devkit.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/persistent?schema=public

# --- Optional services, to test them locally ---
# Cloudflare Email Sending account, token and sender (see .env.server.example).
# Leave blank: demo mode shows sign-in codes on screen instead.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM_EMAIL=
# Sender name on sign-in and escalation emails.
CLOUDFLARE_EMAIL_FROM_NAME=Persistent
# FCM service-account key path and project id, for native Android push.
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=
# Web OAuth client id; enables "Continue with Google".
GOOGLE_WEB_CLIENT_ID=

# --- Wireless adb (development container) ---
# Space or comma-separated host:port targets that scripts/dev/adb-connect.sh
# tries on container start. Android's wireless-debug port changes on every
# toggle, so adb-discover.py rescans and remembers the result in
# ~/.android/adb-endpoint; this only seeds it. See apps/mobile/README.md.
ADB_CONNECT=

# --- Deploy target, on the machine that runs `npm run deploy:prod` ---
# SSH destination of the production server.
DEPLOY_SSH_HOST=user@server.example.com
# The server's git checkout of this repo. The deploy always ships main.
DEPLOY_REPO_PATH=/srv/persistent
# SSH port, when not set in your ssh config.
# DEPLOY_SSH_PORT=
# The nginx sites folder on the server that the site file is installed into. Required: the
# deploy stops before contacting the server without it.
DEPLOY_NGINX_SITES_DIR=/srv/nginx/sites

# --- Android release signing, only to build the release APK locally ---
# The same key as the GitHub Actions secrets, so updates install over each other.
# The keystore file is git-ignored; CI decodes it from ANDROID_KEYSTORE_BASE64.
ANDROID_KEYSTORE_FILE=apps/mobile/release.keystore
# Keystore password.
ANDROID_KEYSTORE_PASSWORD=
# Key alias inside the keystore.
ANDROID_KEY_ALIAS=persistent
# Key password.
ANDROID_KEY_PASSWORD=

# --- Windows builds from the development container (optional) ---
# Host path of your windows-build-tools checkout; Compose mounts it read-only.
# WINDOWS_BUILD_TOOLS=
# SSH alias of the Windows host that builds for the container.
# PERSISTENT_WINDOWS_HOST=
