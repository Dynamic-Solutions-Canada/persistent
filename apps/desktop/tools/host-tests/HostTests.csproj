<Project Sdk="Microsoft.NET.Sdk">
  <!-- Portable checks of the Windows host's pure policies (TEST-2): link rules, the page origin
       gate and the About links. Run by `npm run test:desktop` on any machine with the .NET SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Persistent.Desktop/Windows/FlyoutUrlPolicy.cs" Link="FlyoutUrlPolicy.cs" />
    <Compile Include="../../Persistent.Desktop/Pages/AboutLinks.cs" Link="AboutLinks.cs" />
  </ItemGroup>
</Project>
