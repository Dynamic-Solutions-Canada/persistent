{
  "name": "@persistent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "predev": "npm run build --workspace @persistent/shared",
    "dev": "tsx watch --include \"../../packages/shared/dist/**\" src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@persistent/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/server": "14.1.0",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
