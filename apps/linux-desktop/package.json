{
  "name": "@persistent/linux-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent Linux tray application",
  "author": "Dynamic Solutions Canada",
  "homepage": "https://persistent.dynamic-solutions.ca",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "desktopName": "ca.persistent.desktop.desktop",
  "main": "dist/main.cjs",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --linux AppImage deb",
    "package:dir": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "@particle/dbus-next": "0.11.4",
    "ws": "8.22.0",
    "x11": "4.3.1"
  },
  "devDependencies": {
    "@persistent/shared": "file:../../packages/shared",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "ca.persistent.desktop",
    "productName": "Persistent",
    "executableName": "persistent",
    "artifactName": "Persistent-Linux-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "maintainer": "Dynamic Solutions Canada",
      "desktop": {
        "entry": {
          "Name": "Persistent",
          "Comment": "Reminders that need your confirmation",
          "StartupWMClass": "persistent"
        }
      }
    }
  }
}
