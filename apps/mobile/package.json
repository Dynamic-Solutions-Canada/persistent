{
  "name": "@persistent/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor (Android) wrapper of the web app + the native alarm plugin.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "npm --prefix ../.. run build --workspace @persistent/shared && npm --prefix ../.. run build --workspace @persistent/web",
    "add:android": "cap add android",
    "setup:android": "node scripts/setup-android.mjs",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "assemble:android": "cd android && ./gradlew --no-daemon --max-workers=${ANDROID_GRADLE_WORKERS:-2} --console=plain assembleDirectDebug",
    "assemble:release": "cd android && ./gradlew assembleDirectRelease",
    "bundle:play": "cd android && ./gradlew bundlePlayRelease",
    "prepare:android": "npm run build:web && npm run add:android && npm run setup:android && npm run sync",
    "verify:android": "npm run setup:android && cd android && ./gradlew --no-daemon --max-workers=${ANDROID_GRADLE_WORKERS:-2} --console=plain :app:compilePlayDebugKotlin :app:compilePlayDebugJavaWithJavac :app:compileDirectDebugKotlin :app:compileDirectDebugJavaWithJavac",
    "lint:android": "npm run setup:android && cd android && ./gradlew --no-daemon --max-workers=${ANDROID_GRADLE_WORKERS:-2} --console=plain :app:lintPlayDebug :app:lintDirectDebug",
    "check:android-notices": "npm run setup:android && cd android && ./gradlew --no-daemon --max-workers=${ANDROID_GRADLE_WORKERS:-2} --console=plain :app:renderPlayDebugThirdPartyNotices :app:renderPlayReleaseThirdPartyNotices :app:renderDirectDebugThirdPartyNotices :app:renderDirectReleaseThirdPartyNotices",
    "test:android": "npm run setup:android && cd android && ./gradlew --no-daemon --max-workers=${ANDROID_GRADLE_WORKERS:-2} --console=plain :app:testPlayDebugUnitTest :app:testDirectDebugUnitTest"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.3",
    "@capacitor/preferences": "6.0.4",
    "@capacitor/push-notifications": "6.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3",
    "typescript": "5.9.3"
  }
}
