# --- Stack template (HYG-6, part 1) ---

# Web: dependencies and build output.
node_modules/
dist/
# The Prisma client, generated into the API's source tree by `npm run db:generate`.
/apps/api/src/generated/
.vite/
*.tsbuildinfo
coverage/
*.log
npm-debug.log*

# Windows: .NET / WinUI 3 build output under apps/desktop.
apps/desktop/**/bin/
apps/desktop/**/obj/
apps/desktop/**/AppPackages/
apps/desktop/**/BundleArtifacts/
apps/desktop/**/Generated Files/
apps/desktop/**/*.user

# --- Project rules (HYG-6, part 2) ---

# Python helper caches (the desktop localization prep and build bridge scripts).
__pycache__/
*.pyc

# Firebase credentials: server creds and the APK client config live in .secrets/,
# and CI injects google-services.json from the GOOGLE_SERVICES_JSON secret.
*firebase-adminsdk*.json
google-services.json

# Google Cloud service-account keys download under their project's own name
# (`<project>-<keyid>.json`), so they land in the tree matching none of the rules
# above and one `git add .` from being public. Keys belong in .secrets/; this is
# the backstop for one dropped anywhere else.
/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
*service-account*.json

# Runtime data (root only, so it does not match apps/web/src/data).
/data/

# Agent worktrees live inside the checkout (AI-12).
/.worktrees/

# Capacitor native projects, generated by `cap add` and scripts/setup-android.mjs
# (see apps/mobile/README.md) and never committed. Regenerate with prepare:android.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/

# Android release keystore (CI uses the base64 secret).
apps/mobile/release.keystore

# Play upload bundles.
*.aab

# Mono/MSBuild scratch left by the Linux compile check (verify-csharp.sh): the
# Windows-only MakePri step drops a fake registry here on its way to failing.
apps/desktop/**/.mono/

# Desktop generated build inputs and packages. The app icon and MSIX images are
# committed (npm run icons writes them from assets/brand/); only the widget picker
# preview is rendered at build, by generate-widget-screenshot.ps1.
apps/desktop/artifacts/
apps/desktop/build-inputs/
apps/desktop/Persistent.DesktopMSIX/Images/WidgetScreenshot.png
apps/desktop/**/*.msix
apps/desktop/**/*.msixbundle
# The Store upload container (a zip of the per-arch .msix files, renamed).
apps/desktop/**/*.msixupload

# Linux desktop generated tone, icons and package output.
apps/linux-desktop/resources/icon.png
apps/linux-desktop/resources/app-icon.png
apps/linux-desktop/resources/alarm.wav
apps/linux-desktop/resources/promo/
apps/linux-desktop/artifacts/

# Personal Claude Code settings; the tracked .claude/settings.json holds the
# project's hooks (AI-10).
.claude/settings.local.json

# --- Shared block (HYG-6, part 3) ---

# Shared block (HYG-6), from winui-app-kit build/shared.gitignore. Paste it unchanged as the last part
# of every repo's .gitignore, so no earlier line can un-ignore what it covers. Change it in the kit.
/.artifacts/
/.windows-build/
.secrets/
.aws/
.env
.env.*
!.env*.example
tmp/
.backups/
*.pfx
*.cer
*.der
*.keystore
*.jks
local.properties
.vs/
.idea/
.DS_Store
Thumbs.db
