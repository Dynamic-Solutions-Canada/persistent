# Production server settings (CONF-10). On the server, copy to .env beside
# compose.server.yml; Compose loads it automatically and passes the values the api
# service lists. Development settings are in .env.dev.example.

# --- Database ---
# Database name and user for the compose `db` service.
POSTGRES_DB=persistent
POSTGRES_USER=postgres
# Required, with no default: a long random password.
POSTGRES_PASSWORD=

# --- API ---
# Public URL of the web app, for CORS and secure-cookie detection.
CLIENT_ORIGIN=https://persistent.example.com

# --- Cloudflare Email Sending (sign-in codes and escalation emails) ---
# The sender domain must be set up for sending in Cloudflare (note the mail.
# prefix, for example noreply@mail.example.com). Blank disables email.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
# API token with Email Sending permission.
CLOUDFLARE_EMAIL_API_TOKEN=
# Sender address.
CLOUDFLARE_EMAIL_FROM_EMAIL=
# Sender name.
CLOUDFLARE_EMAIL_FROM_NAME=Persistent

# --- Firebase Cloud Messaging (native Android push) ---
# In-container path of the service-account key; compose.server.yml mounts
# .secrets/fcm-service-account.json at /run/secrets/fcm-service-account.json,
# and the file must be readable by uid 1000 (docs/deployment.md).
FCM_SERVICE_ACCOUNT_FILE=
# Firebase project id.
FCM_PROJECT_ID=

# --- Sign-in ---
# Web OAuth client id: enables "Continue with Google" and is the audience for
# ID-token verification (also the native serverClientId). The Android client id
# only has to exist in the Cloud project (package and SHA-1); nothing reads it.
GOOGLE_WEB_CLIENT_ID=

# --- Web analytics ---
# Self-hosted, cookieless Umami, loaded in web browsers only (never in the Android, Windows or
# Linux apps). Set both to turn it on; leave either empty for no tracker.
UMAMI_SCRIPT_URL=https://analytics.dynamic-solutions.ca/script.js
UMAMI_WEBSITE_ID=
# Comma-separated android:apk-key-hash origins for passkeys, one per signing
# certificate (the release key, plus Play's app-signing key). See lib/webauthn.ts.
# Formerly ANDROID_APP_ORIGIN: the old name still works for one release, with a
# startup warning, and is ignored when this one is set.
ANDROID_APP_ORIGINS=

# --- Administrators ---
# Comma-separated addresses whose verified accounts start with the admin role when
# they are first created. Existing grants are stored in the database; removing an
# address here revokes nobody. Blank means no new account becomes an admin.
ADMIN_EMAILS=admin@example.com

# --- App-store review access ---
# Sign-in is passwordless, so a store reviewer cannot receive the emailed code.
# These let one designated account sign in with a fixed code, which goes in
# Google Play's "App access" form. Both must be set or the path does not exist.
# Point it at a throwaway account holding demo data, never a real one, and rotate
# the code once a review ends. Minimum 12 characters, enforced at boot. See
# apps/api/src/lib/review-access.ts.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=
